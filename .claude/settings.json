{
  "permissions": {
    "deny": [
      "Edit(./service/vendor/wha/**)",
      "Bash(git push --force *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "(cd recognizer && cargo test -q) && (cd device && cargo test --lib -q) || exit 2"
          }
        ]
      }
    ]
  }
}
